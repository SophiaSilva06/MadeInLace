# Configurações da Aplicação
APP_NAME=MadeInLace
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Banco de Dados MySQL Local (Aplicação)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=MADEINLACE

# Banco de Dados de Teste (Regra 07 - MADEINLACE_TEST)
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=sua_senha_aqui
TEST_DB_NAME=MADEINLACE_TEST

# ==============================================================================
# Configuração de E-mail (Autenticação e Recuperação de Senha)
# ==============================================================================
# Modos disponíveis para alternar:
#   1. "console" -> Simulação no terminal (padrão, seguro, offline e não trava em laboratórios)
#   2. "brevo"   -> Envio real via API HTTP 443 (imune a bloqueios de portas em faculdades)
#   3. "smtp"    -> Envio real via SMTP TLS (Gmail, Outlook, Hotmail, Office 365)
EMAIL_MODE=console
EMAIL_FROM=Made In Lace <contato@madeinlace.com>

# Se usar EMAIL_MODE=brevo (Obtenha chave grátis em https://brevo.com):
BREVO_API_KEY=xkeysib-sua_chave_api_aqui
BREVO_SENDER_EMAIL=seu_email_cadastrado_no_brevo@gmail.com

# Se usar EMAIL_MODE=smtp:
# Para Gmail: host=smtp.gmail.com, port=587, user=seu-email@gmail.com, password=senha-de-app-16-digitos
# Para Outlook/Hotmail/Office 365: host=smtp-mail.outlook.com, port=587, user=seu-email@outlook.com, password=sua-senha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_ou_conta
